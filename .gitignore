# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

#
build

# Go workspace file
go.work
go.work.sum

# env file
.env

# vscode files
.vscode

#debug
.old

/docs/

# Local AI-agent configuration and generated code indexes
.jules/
.codex/
.agents/
.claude/
.cursor/
.gemini/
.mcp.json
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
.codegraph/
.codegraph-*/

# Local credentials and environment overrides; keep shareable templates
.env.*
!.env.example
!.env.sample
!.env.template
.aws/
.ssh/

# Local dependencies, caches, and Python environments
node_modules/
.cache/
.local/
__pycache__/
.pytest_cache/
.venv/
venv/

# Profiling and coverage artifacts
*.prof
*.pprof
*.coverprofile
coverage/

# Executables produced by local Go builds
/go-3d-graphics
/3d-graphics
/graphics
/examples/pulse-dock/pulse-dock
